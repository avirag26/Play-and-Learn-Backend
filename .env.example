# MongoDB connection string (e.g. MongoDB Atlas: mongodb+srv://user:password@cluster.example.mongodb.net/)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=play-and-learn
# Optional: DNS servers for Node, if Atlas fails with "querySrv ECONNREFUSED" on some networks.
# DNS_SERVERS=8.8.8.8,1.1.1.1

PORT=4000
# The web app's URL; Google sign-in redirects back here.
FRONTEND_URL=http://localhost:3000

# At least 32 random characters each, all different. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
COOKIE_SECRET=

# Keys the hashes of emailed sign-up codes (at least 32 random characters).
OTP_SECRET=

# Token lifetimes in seconds (defaults: 15 minutes and 30 days).
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# "false" only for local http development; cookies must be Secure in production.
COOKIE_SECURE=true

# Express "trust proxy": which proxies may report the client IP (used for rate limiting).
TRUST_PROXY=loopback, linklocal, uniquelocal

# Google sign-in (optional; the Google button is hidden while these are empty).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Email for sign-up codes. Required in production; in development, codes are printed to the console while empty.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true, SMTP_USER=you@gmail.com,
#        SMTP_PASS=<app password from https://myaccount.google.com/apppasswords> (needs 2-Step Verification)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Play & Learn <no-reply@example.com>
